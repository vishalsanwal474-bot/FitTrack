{
  "name": "fittrack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FitTrack — gym workout & fitness progress tracker",
  "scripts": {
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:client && node scripts/copy-client.js",
    "start": "npm start --prefix server",
    "test:smoke": "npm run test:smoke --prefix server"
  },
  "engines": {
    "node": ">=18"
  }
}
